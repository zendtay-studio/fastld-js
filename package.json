{
  "name": "fastld-js",
  "version": "1.0.3",
  "description": "Simple and Performant Language detection library using 3,4,5-gram matching. Pure JS, zero dependencies, offline-capable. Supports 115 languages.",
  "keywords": [
    "language detection",
    "language-detection",
    "language-detector",
    "language-identification",
    "language-recognition",
    "language-classifier",
    "langdetect",
    "detect language",
    "text-language",
    "nlp",
    "natural-language",
    "n-gram",
    "trigram",
    "multilingual",
    "offline",
    "zero-dependency",
    "typescript",
    "javascript",
    "nodejs",
    "fast",
    "fastld",
    "franc",
    "tinyld",
    "whatlang"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "ZendTay Studio",
    "email": "zendtaystudio@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zendtay-studio/fastld-js.git"
  },
  "bugs": {
    "url": "https://github.com/zendtay-studio/fastld-js/issues"
  },
  "homepage": "https://github.com/zendtay-studio/fastld-js#readme",
  "type": "commonjs",
  "modelVersion": 5,
  "main": "index.js",
  "module": "index.mjs",
  "types": "index.d.ts",
  "sideEffects": false,
  "engines": {
    "node": ">=12"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "fastld-js": "cli.js"
  },
  "scripts": {
    "test": "node test.js",
    "build": "node build.js"
  }
}